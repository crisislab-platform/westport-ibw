# The image only needs main.py, modules/, and docker/data-bundle/. Everything
# below is either large, machine-specific, or a secret -- and the build context
# is uploaded to the daemon whole, so excluding it is not just tidiness.
.git
.env
*.pdf
__pycache__/
**/__pycache__/
*.pyc
.conda/
.vscode/
.claude/

# Reports, figures and HTML maps -- outputs of past analysis, not inputs to a
# run. out/rings and out/building_links.csv ARE needed and reach the image
# through docker/data-bundle/repo/, staged by docker/stage_data.py.
out/
exploratory/
scripts/
run_scripts/
*.png
*.html
*.gpkg
*.csv

# The staged bundle IS the image's data. The patterns above are root-anchored
# and should not reach it, but say so explicitly rather than relying on that.
!docker/data-bundle
